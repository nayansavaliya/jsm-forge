{
  "name": "jsm-forge-service-desk",
  "version": "0.1.0",
  "description": "Enterprise JSM Service Desk — Config-as-Code Forge App",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "forge build",
    "deploy": "ts-node scripts/generate-mock-data.ts && forge deploy",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "validate-config": "ts-node scripts/validate-config.ts",
    "sync-dry-run": "ts-node scripts/sync-dry-run.ts",
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.yaml\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@forge/api": "^7.2.2",
    "@forge/resolver": "^2.0.0",
    "@forge/storage": "^2.0.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@forge/cli": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
